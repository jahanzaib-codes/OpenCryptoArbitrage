# ==============================================================================
# OpenCryptoArbitrage — Configuration
# Cross-Exchange Crypto Arbitrage & Funding Rate Engine (Binance, Bybit, OKX)
# ==============================================================================

# Exchange API Keys (Optional — Simulator mode enabled by default)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Arbitrage Engine Mode
DATA_MODE=simulator         # options: simulator, live
MIN_NET_APY_THRESHOLD=15.0  # Minimum Net Annualized Yield (%) to trigger alert
MIN_SPREAD_PCT=0.25         # Minimum cross-exchange price spread (%) after fees
MAX_POSITION_USD=25000.0    # Maximum single arbitrage leg position size
DEFAULT_LEVERAGE=1.0        # Delta-neutral default (1x spot / 1x short perp)

# Execution & Fee Models
TAKER_FEE_BPS=5.0           # 0.05% standard exchange VIP0 taker fee
MAKER_FEE_BPS=2.0           # 0.02% maker fee
ESTIMATED_SLIPPAGE_BPS=2.0  # 0.02% slippage estimate per leg

# Terminal & Scanning
SCAN_INTERVAL_SECONDS=10
AUTO_PAPER_EXECUTE=false    # Set true to auto-fill simulated paper arbitrage orders
